prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
leanlibdir=@LEAN_LIBDIR@

Name: graphos-lean-critique
Description: Lean 4 critique predicates for Graphos, exported as a versioned C ABI
URL: https://github.com/jeremiepas/graphos-lean-critique
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lgraphoslean
# Lean runtime and C++ dependencies, as reported by the toolchain that built
# this library (`leanc --print-ldflags`): elan's Lean links libc++, Nix's links
# libstdc++. Link statically with `pkg-config --static`. `leanlibdir` is the
# build machine's toolchain path: override it for your own toolchain with
#   pkg-config --define-variable=leanlibdir=<toolchain>/lib/lean --static ...
# gmp and libuv are system dependencies (NixOS: pkgs.gmp, pkgs.libuv).
Libs.private: @LIBS_PRIVATE@
